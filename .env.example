# 模型服务密钥：复制本文件为 .env 后填写。
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=replace-me
ZHIPUAI_API_KEY=replace-me
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选的观测与扩展服务。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=starbridge-rag
TAVILY_API_KEY=
MINERI_API_TOKEN=

# 容器内地址由 compose.yaml 设置；下面两项供本机直接运行 FastAPI 时使用。
DB_URL=postgresql://postgres:123456@localhost:5432/rag_db
MILVUS_URI=http://localhost:19530

# 可选端口和数据库密码。
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
ETCD_PORT=2379
BACKEND_PORT=8000
FRONTEND_PORT=5173
